<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: a bejelentkezés (titkosított munkamenet), a titkosított helyi adatbázis, a beállítások és függő képek sem a felhőmentésbe,
     sem az eszközátvitelbe nem kerülnek. A Keystore-kulcs amúgy sem menthető, így a régi adat úgysem lenne olvasható. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="pending/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="pending/" />
    </device-transfer>
</data-extraction-rules>
